DB_NAME=apartment
DB_USER=vladimir
DB_PASSWORD=secret
DB_PORT=5432
DB_HOST=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Используется только для интеграционных тестов; имя базы обязано оканчиваться на _test.
# TEST_DATABASE_URL=postgresql+psycopg://vladimir:secret@localhost:5433/apartment_test
TEST_DB_NAME=apartment_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_PORT=5433

#JWT
JWT_SECRET_KEY=replace-with-a-new-random-secret   # Сгенерируйте локальный секрет: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ISSUER=apartment-api
JWT_AUDIENCE=apartment-web
ACCESS_TOKEN_EXPIRE_SECONDS=900
